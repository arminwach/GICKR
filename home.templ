package main

import (
"fmt"

)

templ Home(players []Player){
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8"/>
            <title>GICKR</title>
        </head>
        <body>
            <h1>GICKR</h1>
            <ul>
                <form method="POST" action="/players">
                    <label for="name">Player name</label>
                    <input id="name" name="name" type="text" required/>
                    <button type="submit">Add player</button>
                </form>
                for _, player := range players {
                <li>{ player.Name } — { fmt.Sprintf("%d", player.Rating) }</li>
                }
            </ul>
        </body>
    </html>
}