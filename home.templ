package main

import (
"fmt"

)

templ Home(players []Player){
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8"/>
            <title>GICKR</title>
        </head>
        <body>
            <h1>GICKR</h1>
            <ul>
                for _, player := range players {
                <li>{ player.Name } — { fmt.Sprintf("%d", player.Rating) }</li>
                }
            </ul>
        </body>
    </html>
}